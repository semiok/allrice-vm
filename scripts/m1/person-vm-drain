#!/usr/bin/env python3
"""Drain retained Person VMs through the current Worker's private socket."""
import argparse
import http.client
import json
import os
from pathlib import Path
import re
import socket
import stat
import sys
from uuid import UUID


class LocalConnection(http.client.HTTPConnection):
    def __init__(self, path, timeout):
        super().__init__('localhost', timeout=timeout)
        self.path = path

    def connect(self):
        channel = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        channel.settimeout(self.timeout)
        try:
            channel.connect(self.path)
        except OSError:
            channel.close()
            raise
        self.sock = channel


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--socket', required=True, type=Path)
    parser.add_argument('--boot-id', required=True, type=UUID)
    parser.add_argument('--timeout', type=int, default=600)
    options = parser.parse_args()
    if not 1 <= options.timeout <= 3600:
        parser.error('timeout must be 1–3600 seconds')
    path = options.socket
    try:
        directory = path.parent.lstat()
        target = path.lstat()
        if (
            not path.is_absolute()
            or path.name != 'owner'
            or not path.parent.name.startswith('ar-recovery-')
            or not stat.S_ISDIR(directory.st_mode)
            or stat.S_IMODE(directory.st_mode) != 0o700
            or directory.st_uid != os.getuid()
            or not stat.S_ISSOCK(target.st_mode)
            or target.st_uid != os.getuid()
        ):
            raise ValueError('private Worker socket required')
        token = sys.stdin.readline(4097).rstrip('\r\n')
        if not re.fullmatch(r'[^\s\x00-\x1f\x7f]{1,4096}', token):
            raise ValueError('a current platform session token is required on stdin')
        connection = LocalConnection(str(path), options.timeout)
        try:
            connection.request('POST', '/drain-for-upgrade', headers={
                'Authorization': 'Bearer ' + token,
                'X-AllRice-Worker-Boot': str(options.boot_id),
                'Content-Length': '0',
            })
            response = connection.getresponse()
            body = response.read(4097)
            if response.status != 200:
                status = 'Worker declined drain (HTTP %d)' % response.status
                try:
                    failure = json.loads(body)
                except ValueError:
                    failure = None
                if isinstance(failure, dict):
                    code = failure.get('code')
                    if isinstance(code, str) and re.fullmatch(r'[A-Z_]{1,64}', code):
                        status += ' ' + code
                    request_id = failure.get('requestId')
                    if isinstance(request_id, str):
                        status += ' request=' + str(UUID(request_id))
                raise ValueError(status)
            payload = json.loads(body)
        finally:
            connection.close()
        if (
            not isinstance(payload, dict)
            or set(payload) != {'bootId', 'stopped'}
            or payload['bootId'] != str(options.boot_id)
            or type(payload['stopped']) is not int
            or payload['stopped'] < 0
        ):
            raise ValueError('Worker drain response invalid')
        print(json.dumps(payload))
    except (OSError, ValueError, http.client.HTTPException) as error:
        print('person-vm-drain: ' + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
