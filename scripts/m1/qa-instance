#!/bin/bash
# Per-task AllRice QA instance on M1 (rules: AGENTS.md §6 at the repository root). Each instance has its
# own release build, ports, database, data directories and launchd jobs, so tasks
# validate in parallel without touching the shared Dev. Cloud execution is off.
#
#   qa-instance up <task> --owner <line> --card <MET-n> [--ref <branch|sha>] [--ttl 6h] [--wait]
#   qa-instance down <task>                      stop, drop database, remove release and data
#   qa-instance list                             owner, card, age, process, lease, health
#   qa-instance renew <task> [--ttl 6h]           lease from now, at most 24 hours
#
# After `up`: open http://localhost:<webPort> on M1 and log in with the account in
# ~/allrice-qa/_allrice40-<task>/creds.json (also used by: smoke-test --instance <task>).
set -euo pipefail
unset PGHOSTADDR PGSERVICE PGSERVICEFILE
BIN=$(cd "$(dirname "$0")" && pwd -P); . "$BIN/lib.sh"
REPO="$HOME/allrice40-repo"
NODE_BIN="$HOME/.local/opt/node-22.23.2/bin"
export PATH="$NODE_BIN:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PGPORT=5434
MAX_INSTANCES=3
UID_=$(id -u)
LEASE="$BIN/qa-lease.py"
ALLOCATED_TASK=""
PENDING_WORKTREE=""

die() { echo "qa-instance: $*" >&2; exit 1; }
say() { echo "[qa-instance] $*"; }
valid_task() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "task name must match [a-z0-9-], max 31 chars: $1"; }
db_name() { echo "allrice40_qa_${1//-/_}"; }
instances() { ls -1d "$M1_QA"/*/instance.json 2>/dev/null | xargs -n1 dirname 2>/dev/null | xargs -n1 basename 2>/dev/null || true; }
port_busy() { port_open "$1"; }
json_get() { /usr/bin/python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$1" "$2"; }

write_instance() {  # uses the caller's allocation/build variables
  /usr/bin/python3 - "$LEASE" "$dir/instance.json" "$task" "$ref" "$sha" "$web" "$worker" "$db" "${artifact:-}" "$1" "$owner" "$card" "$ttl" "${release:-}" <<'PY'
import json, sys, time, runpy, os
helper, p, task, ref, sha, web, worker, db, art, state, owner, card, ttl, release = sys.argv[1:]
sys.path.insert(0, os.path.dirname(helper))
lease = runpy.run_path(helper)
now = time.time()
old = json.load(open(p)) if os.path.exists(p) else {}
instance = {'task': task, 'ref': ref, 'sha': sha, 'webPort': int(web), 'workerPort': int(worker), 'database': db,
           'repository': 'semiok/allrice-vm', 'repositoryId': 1469490636,
           'nativeArtifactId': art or None, 'cloudExecution': False, 'setup': state,
           'owner': owner, 'card': card,
           # 3.x counts the slot but sees a legacy lease and never reclaims it.
           'repositoryCreatedAt': old.get('repositoryCreatedAt', lease['stamp'](now)),
           'repositoryExpiresAt': old.get('repositoryExpiresAt', lease['stamp'](now + int(ttl))), 'updatedAt': lease['stamp'](now)}
if 'worktree' in old:
    instance['worktree'] = old['worktree']
elif release:
    directory = os.stat(release, follow_symlinks=False)
    instance['worktree'] = {'name': os.path.basename(release), 'device': directory.st_dev, 'inode': directory.st_ino}
lease['write'](p, instance)
PY
}

stop_services() { # task -> 0 once both jobs are gone, their processes exited and ports closed
  local task=$1 f=$2 wp="" kp="" role
  if [ -f "$f" ]; then wp=$(json_get "$f" webPort 2>/dev/null || true); kp=$(json_get "$f" workerPort 2>/dev/null || true); fi
  stop_job "$(qa_label "$task" web)" "$wp" && stop_job "$(qa_label "$task" worker)" "$kp" || return 1
  for role in web worker; do rm -f "$HOME/Library/LaunchAgents/$(qa_label "$task" "$role").plist"; done
}

cmd_list() {
  /usr/bin/python3 "$LEASE" list "$M1_QA"
  local any=0 name task job
  printf '%-20s %-6s %-6s %-9s %-10s %-26s %s\n' TASK WEB WORKER SHA STATE DATABASE REF
  for name in $(instances); do
    any=1
    local f="$M1_QA/$name/instance.json" web worker sha ref db state
    if [[ "$name" == "$M1_QA_PREFIX"* ]]; then
      task=${name#"$M1_QA_PREFIX"}; job=$(qa_label "$task" web)
    else
      task=$name; job="ai.bplabs.allrice-qa-$task-web"
    fi
    web=$(json_get "$f" webPort); worker=$(json_get "$f" workerPort); sha=$(json_get "$f" sha); ref=$(json_get "$f" ref); db=$(json_get "$f" database)
    if curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$web/api/health/ready" 2>/dev/null && curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$worker/health/ready" 2>/dev/null; then state=ready
    elif launchctl print "gui/$UID_/$job" >/dev/null 2>&1; then state=starting
    else state=stopped; fi
    printf '%-20s %-6s %-6s %-9s %-10s %-26s %s\n' "$task" "$web" "$worker" "${sha:0:8}" "$state" "$db" "$ref"
  done
  [ $any = 1 ] || echo "(no QA instances)"
}

cmd_renew() {
  local task=$1 ttl=6h f; shift
  f="$(qa_instance_dir "$task")/instance.json"
  qa_owned "$f" || die "instance $task does not belong to semiok/allrice-vm"
  if [ $# -gt 0 ]; then
    [ $# -eq 2 ] && [ "$1" = --ttl ] || die 'usage: qa-instance renew <task> [--ttl 6h]'
    ttl=$2
  fi
  /usr/bin/python3 "$LEASE" renew "$f" "$ttl"
}

# Allocation lock is held. Never block on another task lock: that task may be
# waiting for the allocation lock itself. Recheck after acquiring its lock.
reclaim_one() {
  local candidate task f lock
  for candidate in $(instances); do
    f="$M1_QA/$candidate/instance.json"
    qa_owned "$f" || continue
    /usr/bin/python3 "$LEASE" reclaimable "$f" || continue
    task=${candidate#"$M1_QA_PREFIX"}; lock=$(qa_lock_file "$task")
    if (
      exec 9>>"$lock"
      flock_fd 9 0 || exit 1
      qa_owned "$f" || exit 1
      /usr/bin/python3 "$LEASE" reclaimable "$f" || exit 1
      local archived
      archived=$(/usr/bin/python3 "$LEASE" archive "$f" "$HOME/allrice40-dev/qa/codex/qa-reclaimed") || exit 2
      # A process may have appeared while logs were being archived.
      /usr/bin/python3 "$LEASE" reclaimable "$f" || exit 1
      say "reclaiming $task; archive=$archived" >&2
      cmd_down "$task" >&2 || exit 2
      rm -f -- "$lock"
    ); then return 0; fi
  done
  return 1
}

cmd_down() {
  local task=$1; valid_task "$task"
  local dir db release; dir=$(qa_instance_dir "$task"); db=$(db_name "$task")
  qa_owned "$dir/instance.json" || die "instance $task does not belong to semiok/allrice-vm (legacy/unknown instances need their owning tools)"
  release=$("$M1_PY" "$M1_TOOLS/service_target.py" qa-worktree "$dir/instance.json") \
    || die "cannot verify the reserved worktree of $task; instance left in place"
  stop_services "$task" "$dir/instance.json" || die "services of $task did not stop within 90s; database and files left in place"
  local exists
  exists=$(psql -h 127.0.0.1 -d postgres -Atc "select 1 from pg_database where datname='$db'") || die "cannot inspect database $db; files left in place"
  if [[ "$exists" = *1* ]]; then
    dropdb -h 127.0.0.1 --force "$db" || die "cannot drop database $db; files left in place"
    say "dropped database $db"
  fi
  if [ -n "$release" ]; then
    # A failed worktree add can leave the reserved directory empty and unregistered.
    git -C "$REPO" worktree remove --force "$release" 2>/dev/null || rmdir "$release" \
      || die "cannot remove reserved worktree $release; instance files left in place"
  fi
  rm -rf -- "$dir" || die "cannot remove instance directory $dir"
  say "instance $task removed"
}

# Called by cmd_up while it holds the allocation lock. Checks the limit, picks the first
# free port pair 3200+2n / 3201+2n, writes instance.json (setup=building), prints "web worker".
cmd_alloc() {
  local task=$1 ref=$2 sha=$3
  local dir db n web worker found=0 claimed=" " t p artifact="" release=""
  dir=$(qa_instance_dir "$task"); db=$(db_name "$task")
  [ ! -e "$dir" ] && [ ! -L "$dir" ] || die "instance path already exists: $dir (qa-instance down $task first)"
  if [ "$(instances | wc -l | tr -d ' ')" -ge "$MAX_INSTANCES" ]; then
    reclaim_one || true
    if [ "$(instances | wc -l | tr -d ' ')" -ge "$MAX_INSTANCES" ]; then
      echo "qa-instance: all $MAX_INSTANCES slots occupied:" >&2
      /usr/bin/python3 "$LEASE" list "$M1_QA" >&2
      return 75
    fi
  fi
  for t in $(instances); do
    # A concurrent `down` may have just removed this one.
    p=$(json_get "$M1_QA/$t/instance.json" webPort 2>/dev/null) || continue
    claimed+="$p $((p + 1)) "
  done
  for n in $(seq 0 49); do
    web=$((3200 + 2 * n)); worker=$((web + 1))
    [[ "$claimed" == *" $web "* || "$claimed" == *" $worker "* ]] && continue
    if ! port_busy "$web" && ! port_busy "$worker"; then found=1; break; fi
  done
  [ $found = 1 ] || die "no free port pair in 3200-3299"
  mkdir -m 700 "$dir" || return 2
  if ! mkdir -m 700 "$dir/.local" "$dir/logs" || ! write_instance building; then
    rmdir "$dir/.local" "$dir/logs" "$dir" 2>/dev/null || true
    return 2
  fi
  echo "$web $worker"
}

# A branch name may exist locally (task worktrees live in ~/allrice40-repo) and on origin.
# Use whichever is newer; refuse when they have diverged. Anything else: rev-parse.
resolve_ref() {
  local ref=$1 l r
  l=$(git -C "$REPO" rev-parse --verify -q "refs/heads/$ref^{commit}" 2>/dev/null || true)
  r=$(git -C "$REPO" rev-parse --verify -q "refs/remotes/origin/$ref^{commit}" 2>/dev/null || true)
  if [ -n "$l" ] && [ -n "$r" ]; then
    if git -C "$REPO" merge-base --is-ancestor "$r" "$l"; then echo "$l"
    elif git -C "$REPO" merge-base --is-ancestor "$l" "$r"; then echo "$r"
    else die "local $ref and origin/$ref have diverged; pass a commit with --ref"; fi
  elif [ -n "$l$r" ]; then echo "$l$r"
  else git -C "$REPO" rev-parse --verify -q "$ref^{commit}" || die "unknown ref: $ref"; fi
}

cmd_up() {
  local task=$1; shift; valid_task "$task"
  local ref="origin/main" owner="" card="" ttl=6h wait=0 started=$SECONDS rc
  while [ $# -gt 0 ]; do case "$1" in
    --ref) ref=${2:?--ref needs a value}; shift 2 ;;
    --owner) owner=${2:?--owner needs a value}; shift 2 ;;
    --card) card=${2:?--card needs a value}; shift 2 ;;
    --ttl) ttl=${2:?--ttl needs a value}; shift 2 ;;
    --wait) wait=1; shift ;;
    *) die "unknown option $1" ;;
  esac; done
  [[ -n "$owner" && "$owner" != *$'\n'* && "$owner" != *$'\r'* && ${#owner} -le 80 ]] || die '--owner (line name, max 80 characters) is required'
  [[ "$card" =~ ^[A-Z][A-Z0-9]*-[1-9][0-9]*$ ]] || die '--card (e.g. MET-220) is required'
  ttl=$(/usr/bin/python3 "$LEASE" ttl "$ttl") || exit 2
  local waited_since; waited_since=$(date +%s)
  local dir db; dir=$(qa_instance_dir "$task"); db=$(db_name "$task")
  [ ! -e "$dir" ] && [ ! -L "$dir" ] || die "instance path already exists: $dir (qa-instance down $task first)"

  dev_plist_pair || die "refusing a mismatched Dev configuration"
  # Other sessions may fetch at the same moment; a ref-lock collision just needs a retry.
  git -C "$REPO" fetch -q origin 2>/dev/null || { sleep 2; git -C "$REPO" fetch -q origin; }
  local sha
  sha=$(resolve_ref "$ref")

  # Claim the slot and ports under a kernel lock (see lib.sh flock_fd), so sessions
  # starting instances together cannot take the same ports or exceed MAX_INSTANCES.
  local web worker artifact="" ports release=""
  while :; do
    exec 7>>"$M1_QA/.alloc.lock"
    flock_fd 7 30 || die "another qa-instance up is still allocating; try again shortly"
    if ports=$(cmd_alloc "$task" "$ref" "$sha"); then exec 7>&-; break; else rc=$?; fi
    exec 7>&-
    [ "$rc" -eq 75 ] && [ "$wait" -eq 1 ] || return "$rc"
    [ -n "${LINEAR_API_KEY:-}" ] || die 'up --wait requires LINEAR_API_KEY for owner-card reminders; do not read Dev credentials'
    /usr/bin/python3 "$LEASE" remind "$M1_QA" "$task" "$owner" "$card" "$waited_since" || echo 'qa-instance: reminder check failed; still waiting' >&2
    [ $((SECONDS - started)) -lt 86400 ] || die 'wait exceeded 24h; no slot allocated'
    sleep 15
  done
  read -r web worker <<<"$ports"
  ALLOCATED_TASK=$task
  say "task=$task ref=$ref sha=${sha:0:8} web=$web worker=$worker db=$db"

  # The build identity preparer accepts direct worktrees under this root. Record
  # the private reservation before Git runs so down can also clean a partial up.
  local worktrees="$HOME/allrice40-worktrees"
  [ ! -L "$worktrees" ] || die "refusing a symlinked worktree root: $worktrees"
  mkdir -p "$worktrees"
  PENDING_WORKTREE=$(mktemp -d "$worktrees/.qa-$task.XXXXXXXX")
  release=$PENDING_WORKTREE
  write_instance building || die "cannot record the reserved worktree of $task"
  PENDING_WORKTREE=""
  git -C "$REPO" worktree add -q --detach "$release" "$sha"
  [ -f "$release/scripts/m1/rice-standard.json" ] || die 'ref has no Rice template; refusing the installed tools template'

  say "installing and building (log: $dir/logs/build.log)"
  ( cd "$release" && pnpm install --frozen-lockfile && \
    pnpm -r --workspace-concurrency=1 --filter '@allrice/worker...' --filter '@allrice/web...' --if-present run build ) \
    > "$dir/logs/build.log" 2>&1 || die "build failed, see $dir/logs/build.log"
  artifact=$(cd "$release" && node apps/worker/scripts/prepare-native-artifact.mjs --root="$PWD" 2>>"$dir/logs/build.log" | tail -1 | /usr/bin/python3 -c 'import json,sys;print(json.load(sys.stdin)["artifactId"])') \
    || die "native artifact preparation failed, see $dir/logs/build.log"
  say "native artifact ${artifact:7:12}…"
  ( cd "$release" && node scripts/dev-release/prepare-identity.mjs --root="$release" --release-sha="$sha" ) \
    >> "$dir/logs/build.log" 2>&1 || die "build identity preparation failed, see $dir/logs/build.log"

  /usr/bin/python3 - "$task" "$dir" "$release" "$db" "$web" "$worker" "$sha" "$artifact" "$(dev_plist web)" "$(dev_plist worker)" "$(qa_label "$task" web)" "$(qa_label "$task" worker)" <<'PY'
import json, os, plistlib, re, shlex, sys, uuid
task, d, rel, db, web, worker, sha, art, web_src, worker_src, web_label, worker_label = sys.argv[1:]
def retired_setting(key):
    return key in ('ALLRICE_DSH_NEW_ROOT_ARTIFACT_ID', 'ALLRICE_CHECKED_DELIVERY_ARTIFACT_IDS') or key.startswith(('ALLRICE_DSH_RETAINED_', 'ALLRICE_DSH_ORIGIN_READER_'))
home = os.path.expanduser('~'); L = f'{d}/.local'
for sub in ('storage', 'executions', 'dsh-runtime', 'native-once-control', 'native-recurring-control', 'project-preview'):
    os.makedirs(f'{L}/{sub}', mode=0o700, exist_ok=True); os.chmod(f'{L}/{sub}', 0o700)
dburl = f'postgres://{os.environ.get("USER","snow")}@127.0.0.1:5434/{db}'
worker_url = f'http://127.0.0.1:{worker}'
once = {'artifactId': art, 'profileId': 'allrice-once-control-v1', 'storageId': f'allrice-qa-{task}-once-{uuid.uuid4().hex[:8]}', 'stateRoot': f'{L}/native-once-control'}
rec = {'artifactId': art, 'profileId': 'allrice-recurring-control-v1', 'storageId': f'allrice-qa-{task}-recurring-{uuid.uuid4().hex[:8]}', 'stateRoot': f'{L}/native-recurring-control'}
overrides = {
    'DATABASE_URL': dburl, 'ALLRICE_WEB_PORT': web, 'ALLRICE_WORKER_PORT': worker,
    'ALLRICE_WORKER_INTERNAL_URL': worker_url, 'ALLRICE_STORAGE_ROOT': f'{L}/storage',
    'ALLRICE_NATIVE_ONCE_REFERENCE': json.dumps(once, separators=(',', ':')),
    'ALLRICE_NATIVE_RECURRING_REFERENCE': json.dumps(rec, separators=(',', ':')),
}
# .env: shared Dev values with this instance's database, ports and storage.
out = []
for line in open(f'{home}/allrice40-dev/.env').read().splitlines():
    key = re.match(r'^\s*(?:export\s+)?([A-Z0-9_]+)\s*=', line)
    if key and (retired_setting(key[1]) or key[1] in overrides): continue
    out.append(line)
out.extend(f'{key}={shlex.quote(value)}' for key,value in overrides.items())
open(f'{d}/.env', 'w').write('\n'.join(out) + '\n'); os.chmod(f'{d}/.env', 0o600)
common = {
    **overrides,
    'ALLRICE_RELEASE_SHA': sha,
    'ALLRICE_DSH_NATIVE_ARTIFACT_ID': art,
    'ALLRICE_DSH_CORDIS_CONFIG': f'{rel}/apps/worker/dsh/allrice-restricted.cordis.yml',
    'ALLRICE_DSH_RUNTIME_ROOT': f'{L}/dsh-runtime',
    'ALLRICE_EXECUTION_ROOT': f'{L}/executions',
    'ALLRICE_DSH_PLATFORM_HOME': f'{home}/allrice40-dev/.local/dsh-platform',
    'ALLRICE_CLOUD_PREVIEW_SOCKET': f'{L}/project-preview/p.sock',
    'ALLRICE_TECHNICAL_WEB_HEALTH_URL': f'http://127.0.0.1:{web}/api/health/ready',
    'ALLRICE_TECHNICAL_WORKER_HEALTH_URL': f'http://127.0.0.1:{worker}/health/ready',
    # QA instances never use the shared sandbox VM; sandbox work is validated on Dev.
    'ALLRICE_CLOUD_RUNNER_ENABLED': '0', 'ALLRICE_CLOUD_MCP_ENABLED': '0',
    # Version identity is sealed above; QA still cannot run Dev maintenance.
    'ALLRICE_DEV_MAINTENANCE_ENABLED': '0',
}
for role, source, label in (('web', web_src, web_label), ('worker', worker_src, worker_label)):
    src = plistlib.load(open(source, 'rb'))
    env = dict(src['EnvironmentVariables']); env.pop('ALLRICE_LOCAL_PORTAL', None)
    for key in list(env):
        if retired_setting(key):
            del env[key]
    env.update(common)
    if role == 'worker': env['ALLRICE_WORKER_CONCURRENCY'] = '2'
    args = src['ProgramArguments']
    node = args[2] if os.path.basename(args[0]) == 'with-env' else args[0]
    script = f'{rel}/apps/web/server.mjs' if role == 'web' else f'{rel}/apps/worker/dist/index.js'
    plist = {'Label': label, 'ProgramArguments': [node, f'--env-file={d}/.env', script] + (['--hostname', '127.0.0.1', '--port', web] if role == 'web' else []),
             'EnvironmentVariables': env, 'KeepAlive': True, 'RunAtLoad': False, 'ExitTimeOut': 60,
             'WorkingDirectory': f'{rel}/apps/web' if role == 'web' else rel,
             'StandardOutPath': f'{d}/logs/{role}.log', 'StandardErrorPath': f'{d}/logs/{role}.err.log'}
    plistlib.dump(plist, open(f'{d}/{role}.plist', 'wb')); os.chmod(f'{d}/{role}.plist', 0o600)
PY
  service_plist_config "$dir/web.plist" "$(qa_label "$task" web)" ALLRICE_WEB_PORT "$web" "$db" "worker-port=$worker" || die 'invalid QA Web configuration'
  service_plist_config "$dir/worker.plist" "$(qa_label "$task" worker)" ALLRICE_WORKER_PORT "$worker" "$db" || die 'invalid QA Worker configuration'

  psql -h 127.0.0.1 -d postgres -Atc "select 1 from pg_database where datname='$db'" | grep -q 1 && die "database $db already exists"
  createdb -h 127.0.0.1 "$db"

  say "preparing database"
  ( cd "$release" && set -a && source "$dir/.env" && set +a && export DATABASE_URL="postgres://$USER@127.0.0.1:5434/$db" && pnpm db:prepare ) \
    > "$dir/logs/db-prepare.log" 2>&1 || die "db:prepare failed, see $dir/logs/db-prepare.log"
  # Same Codex subscription slot as the shared Dev (one row may be enabled at a time).
  local slot; slot=$(psql -h 127.0.0.1 -d allrice40_dev -Atc "select slot from allrice_codex_subscriptions where enabled limit 1")
  psql -h 127.0.0.1 -d "$db" -q -v ON_ERROR_STOP=1 -c "begin; update allrice_codex_subscriptions set enabled=false where enabled; ${slot:+update allrice_codex_subscriptions set enabled=true where slot=$slot;} commit;" >/dev/null

  say "starting services"
  for role in worker web; do
    local launch_plist="$HOME/Library/LaunchAgents/$(qa_label "$task" "$role").plist"
    cp -p "$dir/$role.plist" "$launch_plist"
    launchctl bootstrap "gui/$UID_" "$launch_plist"
    launchctl kickstart "gui/$UID_/$(qa_label "$task" "$role")"
  done
  local ok=0
  for _ in $(seq 1 60); do
    if curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$web/api/health/ready" 2>/dev/null && curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$worker/health/ready" 2>/dev/null; then ok=1; break; fi
    sleep 2
  done
  [ $ok = 1 ] || die "services not ready after 120s; see $dir/logs/*.err.log"

  say "preparing tenant (company, account, Rice)"
  write_instance started
  local drop
  drop=$(psql -h 127.0.0.1 -d "$db" -Atc "select string_agg(id::text, ',') from allrice_platform_dsh_skills where required_tool_refs ?| array['cloud.process.execute','cloud.mcp.call','python.execute','workspace.reconciliation.export']")
  node "$BIN/qa-bootstrap.mjs" --rice "$release/scripts/m1/rice-standard.json" --port "$web" --company "QA-$task" --username "qa-$task" --creds "$dir/creds.json" --no-cloud --drop-skills "$drop" > "$dir/logs/bootstrap.log" 2>&1 \
    || die "tenant bootstrap failed, see $dir/logs/bootstrap.log"

  write_instance ready
  ALLOCATED_TASK=""
  say "ready: http://localhost:$web  (account: $dir/creds.json; smoke: $BIN/smoke-test --instance $task)"
}

cleanup_task_lock() {
  local rc=$?
  trap - EXIT
  [ -z "$PENDING_WORKTREE" ] || rmdir "$PENDING_WORKTREE" 2>/dev/null || true
  if [ "$rc" -ne 0 ] && [ -n "$ALLOCATED_TASK" ]; then
    echo "qa-instance: up $ALLOCATED_TASK failed; slot retained. Clean up: qa-instance down $ALLOCATED_TASK" >&2
  fi
  # All new callers open/try task locks under .alloc.lock, so none can retain an
  # old inode while we unlink. Keep the shared allocation lock permanently.
  qa_task_unlock "$TASK_LOCK"
  exit "$rc"
}

case "${1:-}" in
  up|down|renew)
    op=$1; shift
    [ $# -ge 1 ] || die 'usage: qa-instance up|down|renew <task> (up requires --owner and --card)'
    [ "$op" != down ] || [ $# -eq 1 ] || die "usage: qa-instance down <task>"
    valid_task "$1"
    [ ! -L "$M1_QA" ] || die "refusing a symlinked QA root: $M1_QA"
    mkdir -p "$M1_QA"
    TASK_LOCK=$(qa_lock_file "$1")
    qa_task_lock "$TASK_LOCK" || die "another allocation or operation of $1 is running"
    trap cleanup_task_lock EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    case "$op" in up) cmd_up "$@" ;; down) cmd_down "$1" ;; renew) cmd_renew "$@" ;; esac ;;
  list) cmd_list ;;
  *) sed -n 2,13p "$0"; exit 2 ;;
esac
