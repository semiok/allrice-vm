#!/bin/bash
# 4.0 release smoke. Exit 77 means a documented prerequisite skip.
# smoke-test --dev [--hello] [--expect-sha SHA] [--out DIR] [--vm-unavailable capacity|host]
# smoke-test --instance TASK [same options]
set -euo pipefail
unset PGHOSTADDR PGSERVICE PGSERVICEFILE
NODE="$HOME/.local/opt/node-22.23.2/bin/node"; BIN=$(cd "$(dirname "$0")" && pwd -P)
. "$BIN/lib.sh"
ts=$(date +%Y%m%d-%H%M%S)
json() { /usr/bin/python3 -c 'import json,sys;v=json.load(open(sys.argv[1]))[sys.argv[2]];print("" if v is None else v)' "$1" "$2"; }
penv() { /usr/bin/python3 -c 'import plistlib,os,sys;print(plistlib.load(open(os.path.expanduser(sys.argv[1]),"rb"))["EnvironmentVariables"][sys.argv[2]])' "$1" "$2"; }
case "${1:-}" in
  --dev)
    shift
    dev_plist_pair || exit 2
    web=$(penv "$(dev_plist web)" ALLRICE_WEB_PORT)
    worker=$(penv "$(dev_plist worker)" ALLRICE_WORKER_PORT)
    creds="$HOME/allrice40-dev/qa/smoke-cred.json"; out="$HOME/allrice40-dev/qa/smoke/$ts" ;;
  --instance)
    task=${2:?task}; shift 2
    [[ "$task" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || exit 2
    [ -d "$M1_QA" ] || exit 2
    task_lock=$(qa_lock_file "$task")
    qa_task_lock "$task_lock" || { echo "QA instance is being changed: $task" >&2; exit 3; }
    trap 'qa_task_unlock "$task_lock"' EXIT
    dir=$(qa_instance_dir "$task")
    f="$dir/instance.json"; [ -f "$f" ] || { echo "no QA instance: $task" >&2; exit 2; }
    qa_owned "$f" || { echo "QA instance belongs to another repository: $task" >&2; exit 2; }
    web=$(json "$f" webPort); worker=$(json "$f" workerPort)
    creds="$dir/creds.json"; out="$dir/smoke/$ts"
    qa_db=$(qa_database "$f") || exit 2
    web_label=$(qa_label "$task" web); worker_label=$(qa_label "$task" worker)
    qa_web="$HOME/Library/LaunchAgents/$web_label.plist"
    qa_worker="$HOME/Library/LaunchAgents/$worker_label.plist"
    service_plist_config "$qa_web" "$web_label" ALLRICE_WEB_PORT "$web" "$qa_db" "worker-port=$worker" || exit 2
    service_plist_config "$qa_worker" "$worker_label" ALLRICE_WORKER_PORT "$worker" "$qa_db" || exit 2
    ;;
  *) sed -n '2,4p' "$0"; exit 2 ;;
esac

# Retain the QA instance lock in the shell until the browser runner exits.
rc=0
"$NODE" "$BIN/smoke-test.mjs" --url "http://127.0.0.1:$web" \
  --worker-url "http://127.0.0.1:$worker" --creds "$creds" --out "$out" "$@" || rc=$?
exit "$rc"
