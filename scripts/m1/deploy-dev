#!/bin/bash
# Release train: deploy a version of AllRice to the shared Dev on M1 (rules: AGENTS.md
# §5 and §9 at the repository root). Only the release manager deploys or rolls back.
#
#   deploy-dev --release-manager [--ref <ref>] [--force] [--skip-smoke] [--force-snapshot]
#                                                        build, check, switch, restart, smoke
#              [--require-person-vm-config]             refuse if the private Host file is missing
#              [--person-vm-drain-socket=/private/…/owner]  current Worker socket; pass an admin session on fd 3
#   deploy-dev --release-manager --rollback [<release-dir>]   back to the release before the current one
#   deploy-dev --release-manager --recover                    restore after a deploy that could not finish
#   deploy-dev --status        configured vs running version, journal contract, rollback check, lock, recent deploys
#
# deploy-dev takes the deploy lock itself; do not wrap it in `deploy-lock run`.
#
# 1. Build in a new release directory (no lock; the running Dev is untouched).
# 2. Pre-stop check with the candidate: scripts/dev-release/verify-native-retention.mjs.
#    Anything not covered aborts before anything stops.
# 3. Under the deploy lock: refuse a database with migrations the candidate does not know
#    (or with none at all), or with journals above contract 1 for a candidate that
#    predates the journal contract (a rollback checks both before anything stops);
#    stop Web and Worker and wait until launchd has dropped both jobs, their processes
#    have exited and their ports are closed; when the candidate has migrations not yet
#    applied (or with --force-snapshot), snapshot the database, the state directories,
#    .env and both launchd files into qa/pre-migrate/<release>/ (newest two kept; restore:
#    docs/runbooks/m1-database.md); `pnpm db:prepare` (migrate, sync platform content,
#    verify); point launchd at the new release; start Worker then Web and confirm both
#    report the new source SHA.
#    The previous launchd files are saved in qa/deploy-inflight/ first. However this run
#    ends before success (a failed step, set -e, INT/TERM/HUP) it checks migration and
#    journal compatibility, puts them back, then restarts both services and checks the previous
#    version. If killed outright, `--recover` does the same. Committed migrations are
#    never reverted: an incompatible previous version stays stopped, with the saved
#    files retained for snapshot recovery or a forward fix.
# 4. Records written, lock released, then the smoke test against the expected
#    version. A failed smoke does not roll back by itself; its guidance reflects whether
#    a default rollback target is recorded.
set -euo pipefail
unset DRAIN_TOKEN
DRAIN_TOKEN=""
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  # No candidate subprocess may inherit the administrator's input descriptor.
  { IFS= read -r -u 3 DRAIN_TOKEN || :; } 2>/dev/null
  exec 3<&-
fi
BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P); . "$BIN/lib.sh"
REPO="$HOME/allrice40-repo"; RELEASES="$HOME/allrice40-dev-releases"
STATE="$HOME/allrice40-dev/qa"; LOG="$STATE/deploys.jsonl"; INFLIGHT="$STATE/deploy-inflight"
DISABLED="$M1_DEV_DISABLED"
LOCK="$HOME/allrice40-dev/.local/deploy.lock"; SNAPSHOTS="$STATE/pre-migrate"; KEEP_SNAPSHOTS=2
export PATH="$HOME/.local/opt/node-22.23.2/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
RESULT_FILE=""; RESULT_ID=""
DRAIN_SOCKET=""; RELEASE_STOP_ATTEMPTED=""; RELEASE_STOP_UNCONFIRMED=""
KEEP_RELEASES=3; BLOG=""; FAIL_REASON=""; INFLIGHT_MINE=""; LOCKED=""; BUILD_DIR=""; BUILT=""; PLIST_STAGE=""
WEB_LABEL=ai.bplabs.allrice40-dev-web; WORKER_LABEL=ai.bplabs.allrice40-dev-worker
WEB_PLIST="$HOME/Library/LaunchAgents/$WEB_LABEL.plist"
WORKER_PLIST="$HOME/Library/LaunchAgents/$WORKER_LABEL.plist"
DEPLOY_COMMAND='~/allrice40-dev/bin/deploy-dev'
RECOVERY_HINT="Restore the pre-migration snapshot according to docs/runbooks/m1-database.md or fix forward (move $INFLIGHT aside first if it exists; keep $DISABLED for the next deploy); manual intervention required."

say() { echo "[deploy-dev $(date +%H:%M:%S)] $*"; }
die() { FAIL_REASON=$1; echo "[deploy-dev] FAILED: $1" >&2; exit "${2:-1}"; }
penv() { "$M1_PY" -c 'import plistlib,sys;print(plistlib.load(open(sys.argv[1],"rb"))["EnvironmentVariables"].get(sys.argv[2],""))' "$1" "$2"; }
release_of() { "$M1_PY" -c 'import plistlib,sys;print(plistlib.load(open(sys.argv[1],"rb"))["WorkingDirectory"])' "${1:-$(dev_plist worker)}"; }
web_port() { penv "$(dev_plist web)" ALLRICE_WEB_PORT; }
worker_port() { penv "$(dev_plist worker)" ALLRICE_WORKER_PORT; }
recovery_pair() { # Web plist, Worker plist, [expected SHA]
  dev_plist_config web "$1" && dev_plist_config worker "$2" || return 1
  local rel; rel=$(release_of "$2") || return 1
  [ "$(release_of "$1")" = "$rel/apps/web" ] && dev_release_config "$rel" "${3:-$(penv "$2" ALLRICE_RELEASE_SHA)}"
}
ready_sha() { # url role release -> prints a matching verified sourceSha
  curl -fsS -m 5 "$1" 2>/dev/null | "$M1_PY" "$M1_TOOLS/service_target.py" ready "$2" "$3"; }
worker_boot() { # prints the bootId the ready Worker reports, or nothing; never fails
  { curl -sS -m 5 "http://127.0.0.1:$(worker_port)/health/ready" 2>/dev/null || true; } | "$M1_PY" -c 'import json,re,sys
try: b=str(json.load(sys.stdin)["identity"]["bootId"])
except Exception: b=""
print(b if re.fullmatch("[0-9a-f-]{36}",b) else "")' ; }
wait_ready() { # url sha seconds role release
  local i; for i in $(seq 1 "$3"); do [ "$(ready_sha "$1" "$4" "$5")" = "$2" ] && return 0; sleep 1; done; return 1; }
dev_sql() { "$BIN/with-env" worker sh -c 'psql "$DATABASE_URL" -X -v ON_ERROR_STOP=1 -At -F " " -c "$1"' sh "$1"; }
log_deploy() { "$M1_PY" - "$LOG" "$@" <<'PY'
import json,sys,time
p,*kv=sys.argv[1:]; d=dict(zip(kv[::2],kv[1::2])); d['at']=time.strftime('%Y-%m-%dT%H:%M:%S%z')
open(p,'a').write(json.dumps(d,ensure_ascii=False)+'\n')
PY
}

# A branch may exist locally (worktrees live in ~/allrice40-repo) and on origin: use the
# newer one, refuse diverged ones. Anything else (origin/main, a SHA): rev-parse.
resolve_ref() {
  local ref=$1 l r
  l=$(git -C "$REPO" rev-parse --verify -q "refs/heads/$ref^{commit}" 2>/dev/null || true)
  r=$(git -C "$REPO" rev-parse --verify -q "refs/remotes/origin/$ref^{commit}" 2>/dev/null || true)
  if [ -n "$l" ] && [ -n "$r" ]; then
    if git -C "$REPO" merge-base --is-ancestor "$r" "$l"; then echo "$l"
    elif git -C "$REPO" merge-base --is-ancestor "$l" "$r"; then echo "$r"
    else die "local $ref and origin/$ref have diverged; pass a commit with --ref" 2; fi
  elif [ -n "$l$r" ]; then echo "$l$r"
  else git -C "$REPO" rev-parse --verify -q "$ref^{commit}" || die "unknown ref $ref" 2; fi
}

# The old Worker is the only authority that can certify a live VM as
# quiescent. During rollout, releases without a Host can still be replaced.
vm_upgrade_candidates() {
  local present count
  present=$(dev_sql "select to_regclass('public.person_virtual_machines') is not null") || return 1
  case "$present" in
    f) echo 0; return ;;
    t) ;;
    *) return 1 ;;
  esac
  count=$(dev_sql "select count(*) from public.person_virtual_machines where phase in ('running','starting') or lease_owner is not null or (phase='failed' and (native_created or egress_receipt is not null))") || return 1
  [[ "$count" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$count"
}

worker_drain_cli() {
  local boot=$1 pid=$2
  shift 2
  local args=()
  if [ -n "$DRAIN_SOCKET" ]; then args+=(--socket "$DRAIN_SOCKET"); fi
  "$M1_PY" "$BIN/person-vm-drain" --pid "$pid" --boot-id "$boot" ${args[@]+"${args[@]}"} "$@" <<<"$DRAIN_TOKEN"
}
read_drain_receipt() { worker_drain_cli "$1" "$2"; }
claim_drained_worker() { worker_drain_cli "$1" "$2" --claim-expiry "$3"; }

validate_drain_receipt() {
  "$M1_PY" "$BIN/person-vm-drain" --verify-receipt --boot-id "$1" >/dev/null
}

wait_for_drained_worker_exit() { # pid, plist, release, port
  local pid=$1 plist=$2 rel=$3 port=$4 status output i
  for i in $(seq 1 45); do
    status=$(job_state "$WORKER_LABEL" "$plist" "$rel") || return 1
    case "$status" in
      "running $pid") ;;
      loaded)
        output=$("$M1_LAUNCHCTL" print "gui/$M1_UID/$WORKER_LABEL") || return 1
        if ! kill -0 "$pid" 2>/dev/null &&
          printf '%s\n' "$output" | /usr/bin/awk '
            $1=="last" && $2=="exit" && $3=="code" && $4=="=" { seen++; code=$5 }
            $1=="pid" && $2=="=" { pid++ }
            END { exit !(seen==1 && code=="0" && !pid) }' &&
          port_closed "$port"; then return 0; fi
        ;;
      *) return 1 ;;
    esac
    sleep 1
  done
  return 1
}

record_worker_exit_intent() {
  [ -d "$INFLIGHT" ] || return 0
  (umask 077; printf '%s\n' "$1" "$2" "$3" > "$INFLIGHT/worker-exit.tmp") &&
    mv "$INFLIGHT/worker-exit.tmp" "$INFLIGHT/worker-exit"
}

stop_release_worker() {
  local plist rel port process boot receipt count target status i pid expire
  plist=$(dev_plist worker) || return 1
  rel=$(release_of "$plist") || return 1
  port=$(worker_port) || return 1
  local host
  host=$("$M1_PY" - "$rel" <<'PYTHON'
from pathlib import Path
import json, sys
root = Path(sys.argv[1])
path = '.local/person-vm-host.json'
files = json.loads((root / '.local/dev-build-identity.json').read_text())['files']
if not isinstance(files, list):
    sys.exit(1)
sealed = any(file['path'] == path and file['scope'] == 'worker' for file in files)
if not sealed and ((root / path).exists() or (root / path).is_symlink()):
    sys.exit(1)
print('present' if sealed else 'absent')
PYTHON
  ) || return 1
  if [ "$host" = absent ]; then
    count=$(vm_upgrade_candidates) || return 1
    [ "$count" = 0 ] || {
      say "Person VMs require a current Worker drain receipt. Release blocked."
      return 1
    }
    RELEASE_STOP_ATTEMPTED=1
    stop_job "$WORKER_LABEL" "$port" "$plist" "$rel"
    return
  fi

  process=$(job_state "$WORKER_LABEL" "$plist" "$rel") || return 1
  if [ "$process" = gone ]; then
    count=$(vm_upgrade_candidates) || return 1
    [ "$count" = 0 ] && port_closed "$port" || {
      say "Worker absent and Person VM stop is unconfirmed. Release blocked."
      return 1
    }
    return
  fi
  if [ "$process" = loaded ]; then
    # Resume a previously acknowledged graceful shutdown that ended before
    # launchd registration was removed. It cannot authorize a live process.
    [ -f "$INFLIGHT/worker-exit" ] || return 1
    [ "$(sed -n '1p' "$INFLIGHT/worker-exit")" = "$rel" ] || return 1
    pid=$(sed -n '2p' "$INFLIGHT/worker-exit")
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    count=$(vm_upgrade_candidates) || return 1
    [ "$count" = 0 ] || return 1
    wait_for_drained_worker_exit "$pid" "$plist" "$rel" "$port" || return 1
    "$M1_LAUNCHCTL" bootout "gui/$M1_UID/$WORKER_LABEL" || return 1
    return
  fi
  [[ "$process" =~ ^running\ [1-9][0-9]*$ ]] || return 1
  pid=${process#running }
  # Only an agent staged with this policy stays loaded with no process after a
  # successful SIGTERM. Unconditional KeepAlive starts a replacement Worker.
  if ! "$M1_PY" -c 'import plistlib,sys
keep = plistlib.load(open(sys.argv[1], "rb")).get("KeepAlive")
sys.exit(not (isinstance(keep, dict) and list(keep) == ["SuccessfulExit"] and keep["SuccessfulExit"] is False))' "$plist"; then
    say "Current Worker launch policy does not support a graceful release handoff. Release blocked."
    return 1
  fi
  boot=$(worker_boot) || return 1
  if [ -z "$boot" ] || [ -z "$DRAIN_TOKEN" ] || ! receipt=$(read_drain_receipt "$boot" "$pid"); then
    say "Person VM drain missing or refused. Verify the current Worker socket and active tasks before retrying."
    return 1
  fi
  count=$(vm_upgrade_candidates) || return 1
  [ "$count" = 0 ] || return 1
  target="gui/$M1_UID/$WORKER_LABEL"
  # A refused, changed, or unconfirmed Worker must never fall through to
  # forceful bootout. The exact boot consumes the handoff and exits itself.
  if [ "$(job_state "$WORKER_LABEL" "$plist" "$rel")" != "$process" ] ||
    [ "$(worker_boot)" != "$boot" ] ||
    ! validate_drain_receipt "$boot" <<<"$receipt"; then
    say "The Worker identity or drain receipt changed. Release blocked."
    return 1
  fi
  expire=$("$M1_PY" -c 'import json,sys; print(json.load(sys.stdin)["expiresAt"])' <<<"$receipt") || return 1
  record_worker_exit_intent "$rel" "$pid" "$boot" || return 1
  RELEASE_STOP_UNCONFIRMED=1
  if ! claim_drained_worker "$boot" "$pid" "$expire" ||
    ! wait_for_drained_worker_exit "$pid" "$plist" "$rel" "$port"; then
    say "Worker graceful exit is unconfirmed. Release blocked. Check shutdown-status on its maintenance socket."
    return 1
  fi
  RELEASE_STOP_ATTEMPTED=1; RELEASE_STOP_UNCONFIRMED=""
  "$M1_LAUNCHCTL" bootout "$target" || return 1
  for i in $(seq 1 5); do
    status=$(job_state "$WORKER_LABEL" "$plist" "$rel") || return 1
    [ "$status" != gone ] || break
    [ "$status" = loaded ] || return 1
    sleep 1
  done
  [ "$status" = gone ] && port_closed "$port" || return 1
  say "Person VM drain consumed: $receipt"
  log_deploy kind person-vm-drain receipt "$receipt" log "$BLOG"
}

stop_both() {
  stop_release_worker || return 1
  RELEASE_STOP_ATTEMPTED=1
  stop_job "$WEB_LABEL" "$(web_port)"
}
# Diagnostic only, never a gate (MET-221 D13): what the stopped Worker boot left behind.
report_after_stop() { # boot of the stopped Worker, or ""
  local open="" live
  if [ -n "$1" ]; then
    open=$(dev_sql "select count(*) from allrice_dsh_runtime_close_observations o where o.worker_boot_id='$1'
      and o.observation_kind='owned' and not exists (select 1 from allrice_dsh_runtime_close_observations c
      where c.runtime_id=o.runtime_id and c.worker_boot_id=o.worker_boot_id and c.observation_kind='process_closed')" 2>&1) || open="? (${open:0:120})"
  fi
  live=$(dev_sql "select count(*) from allrice_dsh_runtime_instances where status='live'" 2>&1) || live="? (${live:0:120})"
  say "after stop (diagnostic, not a gate): stopped boot ${1:-unknown}: ${open:-?} runtimes owned without process_closed; $live live rows in allrice_dsh_runtime_instances"
}

# Pre-migration snapshot. Both services are stopped, so the database and the state
# directories are one point in time: the dump format and directories of backup-daily
# (restore: docs/runbooks/m1-database.md) as APFS clones, plus .env and both launchd files.
snapshot() ( # name -> 0 when $SNAPSHOTS/<name> is complete
  umask 077
  dev_plist_pair || exit 1
  dir="$SNAPSHOTS/$1" L="$HOME/allrice40-dev/.local"
  [ ! -e "$dir" ] || { echo "$dir already exists" >&2; exit 1; }
  trap 'rm -rf -- "$dir.tmp"' EXIT # a partial snapshot is never left behind
  # Under the deploy lock no other snapshot runs: any *.tmp is left over from a killed run.
  mkdir -p "$SNAPSHOTS" && rm -rf -- "$SNAPSHOTS"/*.tmp && mkdir "$dir.tmp" || exit 1
  "$BIN/with-env" worker sh -c 'pg_dump -Fp --no-owner --no-privileges "$DATABASE_URL"' | gzip -6 > "$dir.tmp/allrice40_dev.sql.gz" || exit 1
  for d in $M1_DEV_BACKUP_DIRS; do [ ! -e "$L/$d" ] || cp -c -pR "$L/$d" "$dir.tmp/$d" || exit 1; done
  cp -p "$HOME/allrice40-dev/.env" "$dir.tmp/env" && cp -p "$(dev_plist web)" "$dir.tmp/web.plist" && cp -p "$(dev_plist worker)" "$dir.tmp/worker.plist" || exit 1
  mv "$dir.tmp" "$dir" || exit 1
  # Pruning is best effort: the new snapshot is complete either way.
  ls -1d "$SNAPSHOTS"/2*/ | grep -v '\.tmp/$' | sort -r | tail -n +$((KEEP_SNAPSHOTS + 1)) \
    | while read -r old; do rm -rf -- "$old" || echo "could not prune $old" >&2; done
  exit 0
)
start_both_on() { # sha -> start Worker then Web, both must identify this release
  recovery_pair "$WEB_PLIST" "$WORKER_PLIST" "$1" || return 1
  local rel; rel=$(release_of) || return 1
  start_job "$WORKER_LABEL" "$WORKER_PLIST" || return 1
  wait_ready "http://127.0.0.1:$(worker_port)/health/ready" "$1" 180 worker "$rel" || { say "worker did not become ready on ${1:0:8}"; return 1; }
  start_job "$WEB_LABEL" "$WEB_PLIST" || return 1
  wait_ready "http://127.0.0.1:$(web_port)/api/health/ready" "$1" 120 web "$rel" || { say "web did not become ready on ${1:0:8}"; return 1; }
}

# Point both plists at a release: script paths, working dirs, cordis config, SHA, and
# the approved native artifact, even if only one plist was switched last time.
# Launch through the same with-env version as precheck: Node must not reload the
# original --env-file after retired settings have been removed.
point_plists() { # release sha artifact stage-dir
  "$M1_PY" - "$4" "$1" "$2" "$3" "$(dev_plist web)" "$(dev_plist worker)" "$BIN/with-env" "$M1_TOOLS" <<'PY'
import os,plistlib,sys
out,rel,sha,art,web_src,worker_src,loader,tools=sys.argv[1:]
sys.path.insert(0,tools)
from service_target import DEV_DATABASE, DEV_PORTS, service_config
plists={}
for role,src in (('web',web_src),('worker',worker_src)):
    d=plistlib.load(open(src,'rb')); e=d['EnvironmentVariables']
    port_key='ALLRICE_'+role.upper()+'_PORT'
    if not service_config(d,'ai.bplabs.allrice40-dev-'+role,port_key,str(DEV_PORTS[role]),DEV_DATABASE,tools):
        sys.exit('refusing source 4.0 '+role+' launch configuration')
    args=d['ProgramArguments']
    if os.path.basename(args[0]) == 'with-env': args=args[2:] # a previous deploy, possibly with older tools
    if args[1].startswith('--env-file='): del args[1]
    args[1]=f'{rel}/apps/web/server.mjs' if role=='web' else f'{rel}/apps/worker/dist/index.js'
    d['ProgramArguments']=[loader,role,*args]
    if 'Program' in d:
        d['Program']=loader
    d['WorkingDirectory']=f'{rel}/apps/web' if role=='web' else rel
    if role == 'worker': d['KeepAlive'] = {'SuccessfulExit': False}
    e['ALLRICE_DSH_CORDIS_CONFIG']=f'{rel}/apps/worker/dsh/allrice-restricted.cordis.yml'
    e['ALLRICE_RELEASE_SHA']=sha
    for key in list(e):
        if key in ('ALLRICE_DSH_NEW_ROOT_ARTIFACT_ID', 'ALLRICE_CHECKED_DELIVERY_ARTIFACT_IDS') or key.startswith(('ALLRICE_DSH_RETAINED_', 'ALLRICE_DSH_ORIGIN_READER_')):
            del e[key]
    e['ALLRICE_DSH_NATIVE_ARTIFACT_ID']=art
    if not service_config(d,'ai.bplabs.allrice40-dev-'+role,port_key,str(DEV_PORTS[role]),DEV_DATABASE,tools):
        sys.exit('refusing generated 4.0 '+role+' launch configuration')
    plists[role]=d
for role,d in plists.items():
    path=f'{out}/{role}.plist'; plistlib.dump(d,open(path,'wb')); os.chmod(path,0o600)
PY
}
stage_plists() {
  PLIST_STAGE=$(mktemp -d "$STATE/deploy-plists.XXXXXX") || return 1
  point_plists "$@" "$PLIST_STAGE"
}
activate_plists() { mv -f "$PLIST_STAGE/web.plist" "$WEB_PLIST" && mv -f "$PLIST_STAGE/worker.plist" "$WORKER_PLIST"; }

# --- lock and in-flight state ---
take_lock() { # -> 0 held, 3 busy
  mkdir -p "$(dirname "$LOCK")"
  exec 9>>"$LOCK"
  if ! flock_fd 9 0; then exec 9>&-; return 3; fi
  LOCKED=1
  "$M1_PY" -c 'import json,os,sys,time
json.dump({"task":"release-train","pid":int(sys.argv[2]),"startedAt":int(time.time()),"command":"deploy-dev "+sys.argv[3]},open(sys.argv[1]+".tmp","w"))
os.replace(sys.argv[1]+".tmp",sys.argv[1])' "$LOCK.owner" $$ "${MODE:-}"
}
release_lock() { if [ -n "$LOCKED" ]; then exec 9>&-; LOCKED=""; fi; return 0; }
inflight_begin() { # prev_sha
  local web worker; web=$(dev_plist web); worker=$(dev_plist worker)
  recovery_pair "$web" "$worker" "$1" || die "Dev cannot provide a same-release recovery pair" 2
  [ ! -e "$INFLIGHT" ] || die "an earlier deploy did not finish (qa/deploy-inflight exists); run $DEPLOY_COMMAND --release-manager --recover"
  mkdir -p "$INFLIGHT.tmp"
  cp -p "$web" "$INFLIGHT.tmp/web.plist" && cp -p "$worker" "$INFLIGHT.tmp/worker.plist" || die "could not save the launchd files"
  recovery_pair "$INFLIGHT.tmp/web.plist" "$INFLIGHT.tmp/worker.plist" "$1" || die "saved launchd files do not form a recovery pair" 2
  printf 'stopping\n%s\n' "$1" > "$INFLIGHT.tmp/state"
  mv "$INFLIGHT.tmp" "$INFLIGHT"; INFLIGHT_MINE=1
}
inflight_phase() { printf '%s\n%s\n' "$1" "$(sed -n 2p "$INFLIGHT/state")" > "$INFLIGHT/state.tmp" && mv "$INFLIGHT/state.tmp" "$INFLIGHT/state"; }
inflight_end() { rm -rf -- "$INFLIGHT" "$DISABLED"; INFLIGHT_MINE=""; }
# Both jobs have been stopped. Move the active configurations out of launchd's
# login directory; the original rollback copies in INFLIGHT remain untouched.
park_plists() {
  mkdir -p -m 700 "$DISABLED" || return 1
  local role p rc=0
  for role in web worker; do
    p="$HOME/Library/LaunchAgents/ai.bplabs.allrice40-dev-$role.plist"
    [ ! -e "$p" ] || mv "$p" "$DISABLED/$role.plist" || rc=1
  done
  return "$rc"
}
refuse_restore() { # phase previous_sha reason
  local reason="not starting ${2:0:8}: $3. Services remain stopped."
  if park_plists; then
    reason="$reason LaunchAgents plists parked in $DISABLED; login will not restart these services."
  else
    reason="$reason Could not park all LaunchAgents plists; do not log out or reboot M1 until they are moved."
  fi
  reason="$reason $RECOVERY_HINT"
  say "$reason"
  log_deploy kind failed phase "$1" reason "$reason" restored no manualIntervention required log "$BLOG" || true
  return 1
}
# Put the saved launchd files back, restart both and check they are healthy on the
# previous SHA. Every step is checked: on any failure the saved files stay for a person.
restore() {
  local prev; prev=$(sed -n 2p "$INFLIGHT/state" 2>/dev/null) && [ -n "$prev" ] || { say "no saved previous version to restore"; return 1; }
  local why rel; rel=$(release_of "$INFLIGHT/worker.plist") || return 1
  recovery_pair "$INFLIGHT/web.plist" "$INFLIGHT/worker.plist" "$prev" && dev_plist_pair || return 1
  say "restoring the previous version ${prev:0:8}"
  stop_both || { say "could not stop the services to restore them"; return 1; }
  if ! why=$(check_migrations_known "$rel"); then
    refuse_restore restore-migrations "$prev" "$why"; return 1
  fi
  # The new Worker may have raised the journal contract: never start a version that cannot read it.
  if ! why=$(check_contract_known "$rel"); then
    refuse_restore restore-contract "$prev" "$why"; return 1
  fi
  cp -p "$INFLIGHT/web.plist" "$WEB_PLIST" && cp -p "$INFLIGHT/worker.plist" "$WORKER_PLIST" \
    && cmp -s "$INFLIGHT/web.plist" "$WEB_PLIST" && cmp -s "$INFLIGHT/worker.plist" "$WORKER_PLIST" \
    || { say "could not put back the saved launchd files from $INFLIGHT"; return 1; }
  start_both_on "$prev" || { say "previous version ${prev:0:8} did NOT come back healthy (migrations applied by the new version stay)"; return 1; }
  say "previous version ${prev:0:8} is healthy again"
}
# Keep a final error/signal handler while the EXIT cleanup runs; replacing an
# EXIT trap inside itself would not run a second EXIT trap. Publish the actual exit.
finish_result() {
  local rc=$1
  trap - EXIT ERR INT TERM HUP
  if [ -n "$RESULT_FILE" ]; then
    "$M1_PY" "$BIN/deploy-result.py" finish "$RESULT_FILE" "$RESULT_ID" "$rc" "${RESULT_INITIAL_EXIT:-$rc}" || {
      echo "[deploy-dev] could not persist terminal receipt: $RESULT_FILE" >&2
      [ "$rc" != 0 ] || rc=74
    }
    echo "[deploy-dev] terminal result: $RESULT_FILE"
  fi
  exit "$rc"
}
# One exit path for every way this run can end before success.
on_exit() { # rc
  local rc=$1
  RESULT_INITIAL_EXIT=$rc
  trap - EXIT
  set -E # inherit the cleanup error handler in shell functions
  trap 'finish_result $?' ERR
  trap 'finish_result 130' INT TERM HUP
  [ -z "$PLIST_STAGE" ] || rm -rf -- "$PLIST_STAGE" || true
  # A build that did not get past the pre-stop check is removed; a checked one is kept.
  if [ -n "$BUILD_DIR" ] && [ -z "$BUILT" ]; then discard "$BUILD_DIR" || true; fi
  if [ -n "$INFLIGHT_MINE" ] && [ -f "$INFLIGHT/state" ]; then
    local phase; phase=$(sed -n 1p "$INFLIGHT/state")
    say "did not finish (phase '$phase', exit $rc)"
    if [ "$phase" = stopping ] && [ -n "$RELEASE_STOP_UNCONFIRMED" ]; then
      log_deploy kind failed phase "$phase" reason "${FAIL_REASON:-exit $rc}" restored unconfirmed log "$BLOG" || true
      say "Worker exit unconfirmed. Saved launchd files: $INFLIGHT. Inspect the old Worker's shutdown status before recovery."
    elif [ "$phase" = stopping ] && [ -z "$RELEASE_STOP_ATTEMPTED" ]; then
      log_deploy kind failed phase "$phase" reason "${FAIL_REASON:-exit $rc}" restored untouched log "$BLOG" || true
      rm -rf -- "$INFLIGHT"
      INFLIGHT_MINE=""
    elif restore; then
      log_deploy kind failed phase "$phase" reason "${FAIL_REASON:-exit $rc}" restored yes log "$BLOG" || true
      inflight_end
    else
      log_deploy kind failed phase "$phase" reason "${FAIL_REASON:-exit $rc}" restored no log "$BLOG" || true
      echo "[deploy-dev] Dev may be down. Saved launchd files: $INFLIGHT. After fixing the cause: $DEPLOY_COMMAND --release-manager --recover" >&2
    fi
  fi
  release_lock
  finish_result "$rc"
}
trap 'on_exit $?' EXIT
trap 'exit 130' INT TERM HUP

# Pre-stop check: does the candidate cover every chat, origin and schedule control that
# exists now? Runs the candidate's own verifier against the live database.
precheck() { # rel sha art log -> prints the reason on failure
  local from; from=$(( $([ -f "$4" ] && wc -l < "$4" || echo 0) + 1 )) # read only this check's output
  if ( cd "$1" && "$BIN/with-env" worker env ALLRICE_DSH_NATIVE_ARTIFACT_ID="$3" \
         ALLRICE_DSH_CORDIS_CONFIG="$1/apps/worker/dsh/allrice-restricted.cordis.yml" \
         node scripts/dev-release/verify-native-retention.mjs --root="$1" --release-sha="$2" ) >> "$4" 2>&1; then return 0; fi
  local out reason code; out=$(tail -n "+$from" "$4")
  reason=$(grep -oE "(DSH_NATIVE_[A-Z_]+|NATIVE_RETENTION_[A-Z_]+)( \[.{0,250})?" <<<"$out" | tail -1 || true); code=${reason%% *}
  if grep -qE 'relation "[^"]+" does not exist' <<<"$out"; then
    echo "the candidate's checker needs tables from migrations not yet applied: a defect, the checker must run on the schema before its migrations"
  elif [[ "$code" == *INCOMPATIBLE* ]]; then
    echo "existing contexts are incompatible with this version: ${reason:0:300}. Archive them or confirm first"
  elif [[ "$code" == *JOURNAL_CONTRACT* ]]; then
    echo "this version's journal contract range does not cover the journals in the database: ${reason:0:300}"
  else echo "pre-stop native check failed: ${reason:-see $4}"; fi
  return 1
}

discard() { git -C "$REPO" worktree remove --force "$1" 2>/dev/null || rm -rf -- "$1"; git -C "$REPO" worktree prune; }

status() {
  dev_plist_pair || die "refusing a mismatched Dev configuration" 2
  if [ ! -f "$WEB_PLIST" ] || [ ! -f "$WORKER_PLIST" ]; then
    echo "PARKED configuration in $DISABLED; launchd has no Dev jobs"
  fi
  local worker_release web_dir
  worker_release=$(release_of); web_dir=$(release_of "$(dev_plist web)")
  echo "configured release: $worker_release"
  echo "configured sha:     $(penv "$(dev_plist worker)" ALLRICE_RELEASE_SHA)"
  echo "running sha:        web $(ready_sha "http://127.0.0.1:$(web_port)/api/health/ready" web "${web_dir%/apps/web}" | cut -c1-8)  worker $(ready_sha "http://127.0.0.1:$(worker_port)/health/ready" worker "$worker_release" | cut -c1-8)  (empty = not ready)"
  echo "native artifact:    $(penv "$(dev_plist worker)" ALLRICE_DSH_NATIVE_ARTIFACT_ID) (configured)"
  echo "tools version:      $(cat "$BIN/TOOLS_VERSION" 2>/dev/null || echo "unknown ($BIN)")"
  local row hw prev why
  if ! row=$(contract_row 2>/dev/null); then hw="unknown (database not readable)"
  elif [ -z "$row" ]; then hw="not written yet"; else hw=${row#row:}; fi
  echo "journal contract:   high water $hw"
  if ! prev=$(previous_release); then echo "rollback check:     no recorded previous release (use $DEPLOY_COMMAND --release-manager --rollback <release-dir>)"
  elif ! dev_release_config "$prev" 2>/dev/null; then echo "rollback check:     $(basename "$prev") would be REFUSED: expected a sealed 4.0 release"
  elif ! why=$(check_migrations_known "$prev") || ! why=$(check_contract_known "$prev"); then
    echo "rollback check:     $(basename "$prev") would be REFUSED: $why"
  elif [ -f "$prev/packages/database/dist/native-journal-contract-store.js" ]; then
    echo "rollback check:     $(basename "$prev") knows every applied migration and the journal contract (pre-stop check not run)"
  else echo "rollback check:     $(basename "$prev") knows every applied migration; it predates the journal contract, fine while the journals are at contract 1 (pre-stop check not run)"; fi
  if [ -e "$INFLIGHT" ]; then
    if lock_held "$LOCK"; then echo "DEPLOY IN PROGRESS (phase '$(sed -n 1p "$INFLIGHT/state" 2>/dev/null)')"
    else echo "UNFINISHED DEPLOY (phase '$(sed -n 1p "$INFLIGHT/state" 2>/dev/null)'): run $DEPLOY_COMMAND --release-manager --recover"; fi
  fi
  "$BIN/deploy-lock" status || true
  [ -f "$LOG" ] && { echo "recent deploys:"; tail -5 "$LOG"; }
  return 0
}

recover() {
  take_lock || die "deploy lock is held; $("$BIN/deploy-lock" status)" 3
  [ -f "$INFLIGHT/state" ] || die "nothing to recover (no unfinished deploy recorded)"
  local phase; phase=$(sed -n 1p "$INFLIGHT/state")
  restore || die "recovery did not bring the previous version back; see above"
  log_deploy kind recover phase "$phase" restored yes
  inflight_end
  say "recovered"
}

prune_releases() { # keep the current, the previous and the newest KEEP_RELEASES deploy-created ones
  local current previous; current=$(release_of)
  previous=$(sed -n 1p "$STATE/.previous-release" 2>/dev/null || true)
  ls -1dt "$RELEASES"/20[0-9][0-9][0-9][0-9][0-9][0-9]-* 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | while read -r old; do
    [ "$old" = "$current" ] || [ "$old" = "$previous" ] && continue
    git -C "$REPO" worktree remove --force "$old" 2>/dev/null || rm -rf -- "$old"
    say "pruned old release $(basename "$old")"
  done
  git -C "$REPO" worktree prune
}

# Recorded facts about a release: "sha artifact", from the newest log entry that has both.
release_facts() {
  [ -f "$LOG" ] || return 1
  "$M1_PY" - "$LOG" "$1" <<'PY'
import json,sys
log,rel=sys.argv[1:]
for line in reversed(open(log).read().splitlines()):
    try: d=json.loads(line)
    except Exception: continue
    for side in ('to','from'):
        if d.get(side+'Release')==rel and d.get(side+'Sha') and d.get(side+'Artifact'):
            print(d[side+'Sha'], d[side+'Artifact']); sys.exit(0)
sys.exit(1)
PY
}

# What the database has applied against what a release knows: migration_diff (lib.sh).
migrations_vs() { # release -> "unknown|pending <name>" lines; on failure prints the reason, exit 1
  local applied
  applied=$(dev_sql "select name from allrice_schema_migrations order by name") || { echo "cannot read allrice_schema_migrations"; return 1; }
  [ -n "$applied" ] || { echo "allrice_schema_migrations is empty"; return 1; }
  printf '%s\n' "$applied" | migration_diff "$1"
}
# An older binary refuses a database with migrations it does not know (db:verify): the
# rollback gate. A deploy uses the same diff to learn what db:prepare is going to run.
check_migrations_known() { # release -> prints pending names; distinguishes unknown migrations from failed checks, exits 1
  local diff unknown
  diff=$(migrations_vs "$1") || { echo "migration compatibility could not be checked: $diff"; return 1; }
  unknown=$(printf '%s\n' "$diff" | sed -n 's/^unknown //p')
  [ -z "$unknown" ] || { printf 'the database has applied migrations this version does not know: '; echo "$unknown" | head -5 | tr '\n' ' '; return 1; }
  printf '%s\n' "$diff" | sed -n 's/^pending //p'
}
# Journals written under a contract above 1 need a release that knows the high water
# (MET-221 PR2b-1). An older one has no contract check of its own, so its pre-stop check
# would pass while its Worker cannot read them. The marker is the built
# packages/database/dist/native-journal-contract-store.js: renaming that module needs
# this check changed in the same PR.
contract_row() { # "row:<highWater>", "row:invalid <value>" when it is not a JSON number, nothing when there is no row
  dev_sql "select 'row:' || $CONTRACT_HW from allrice_runtime_metadata where key='dsh-journal-contract'"
}
CONTRACT_HW="case when jsonb_typeof(value->'highWater') = 'number' then value->>'highWater' else 'invalid ' || value::text end"
check_contract_known() { # release -> 0; prints why and exits 2 when it predates the contract reached, 1 when unreadable
  local row hw
  row=$(contract_row) || { echo "cannot read the journal contract high water"; return 1; }
  hw=${row#row:}; [ -n "$row" ] || hw=1 # no row yet: every journal is contract 1
  [[ "$hw" =~ ^[1-9][0-9]{0,8}$ ]] || { echo "unreadable journal contract row: ${hw:0:120}"; return 1; }
  [ "$hw" -le 1 ] || [ -f "$1/packages/database/dist/native-journal-contract-store.js" ] \
    || { echo "the journals reach contract $hw and $(basename "$1") predates the journal contract (no native-journal-contract-store.js)"; return 2; }
}
# With both services stopped and before db:prepare: snapshot when migrations are pending
# (they may be one-way) or when forced.
pre_migrate_snapshot() { # name pending forced
  if [ -z "$2" ] && [ "$3" != 1 ]; then say "no migrations to apply; no snapshot"; return 0; fi
  inflight_phase snapshot
  say "snapshot before migrating ($([ -n "$2" ] && echo "to apply:" $2 || echo "forced; no migrations to apply")) into $SNAPSHOTS/$1"
  local t; t=$(date +%s)
  snapshot "$1" || die "pre-migration snapshot failed"
  say "snapshot taken in $(( $(date +%s) - t ))s ($(du -sh "$SNAPSHOTS/$1" | cut -f1))"
}
previous_release() { # the release deployed before the current one, when recorded
  local prev; prev=$(sed -n 1p "$STATE/.previous-release" 2>/dev/null || true)
  [ -n "$prev" ] && [ "$(sed -n 2p "$STATE/.previous-release")" = "$(release_of)" ] && echo "$prev"
}

rollback_gate() { # target sha -> dies, before anything stops, when the target cannot run on this database
  local why phase reason
  if ! why=$(check_migrations_known "$1"); then phase=rollback-migrations
  elif ! why=$(check_contract_known "$1"); then phase=rollback-contract
  else return 0; fi
  reason="cannot roll back to ${2:0:8}: $why. Dev untouched. $RECOVERY_HINT"
  log_deploy kind failed phase "$phase" toRelease "$1" toSha "$2" reason "$reason" manualIntervention required log "$BLOG" || true
  die "$reason"
}

rollback() { # [release-dir]
  recovery_pair "$(dev_plist web)" "$(dev_plist worker)" || die "refusing a mismatched Dev configuration" 2
  local cur_rel cur_sha cur_art target="${1:-}"
  cur_rel=$(release_of); cur_sha=$(penv "$(dev_plist worker)" ALLRICE_RELEASE_SHA); cur_art=$(penv "$(dev_plist worker)" ALLRICE_DSH_NATIVE_ARTIFACT_ID)
  if [ -z "$target" ]; then
    target=$(previous_release) \
      || die "no recorded previous release for the current one ($cur_rel); pass the target: --rollback <release-dir>"
  fi
  [ -d "$target" ] || die "release directory is gone: $target"
  [ "$target" != "$cur_rel" ] || die "Dev already runs $target"
  local facts sha art; facts=$(release_facts "$target") || die "no recorded SHA and artifact for $target"
  read -r sha art <<<"$facts"
  dev_release_config "$target" "$sha" || die "refusing an invalid 4.0 release" 2
  rollback_gate "$target" "$sha"
  mkdir -p "$STATE/deploy-logs"; BLOG="$STATE/deploy-logs/rollback-$(date +%Y%m%d-%H%M%S).log"
  say "checking that ${sha:0:8} covers the current native references"
  local why; why=$(precheck "$target" "$sha" "$art" "$BLOG") || die "$why. Dev untouched."
  take_lock || die "deploy lock is held; $("$BIN/deploy-lock" status)" 3
  recovery_pair "$(dev_plist web)" "$(dev_plist worker)" "$cur_sha" || die "refusing a mismatched Dev configuration" 2
  [ "$(release_of)" = "$cur_rel" ] || die "the current release changed while checking; start again"
  stage_plists "$target" "$sha" "$art" || die "rollback configuration failed validation. Dev untouched" 2
  rollback_gate "$target" "$sha" # a deploy that ended meanwhile may have raised either
  say "rolling back to $(basename "$target") (${sha:0:8}); database migrations are not reverted"
  inflight_begin "$cur_sha"
  stop_both || die "services did not stop"
  inflight_phase switching
  activate_plists
  start_both_on "$sha" || die "rollback target did not become healthy"
  # Records first, then clear the in-flight state, then release the lock.
  log_deploy kind rollback fromRelease "$cur_rel" fromSha "$cur_sha" fromArtifact "$cur_art" toRelease "$target" toSha "$sha" toArtifact "$art"
  rm -f "$STATE/.previous-release" # a second --rollback must name its target: rolling back is not a stack
  inflight_end; release_lock
  say "rolled back; Dev runs ${sha:0:8}"
}

person_vm_config_arg() {
  "$M1_PY" - "$HOME/allrice40-dev/config/person-vm-host.json" "$1" <<'PY'
import os, stat, sys
path, required = sys.argv[1:]
try:
    entry = os.lstat(path)
except FileNotFoundError:
    if required == '1':
        sys.exit(f'{path}: required person VM host configuration is missing')
    sys.exit(0)
except OSError:
    sys.exit(f'{path}: cannot inspect person VM host configuration')
if (not stat.S_ISREG(entry.st_mode)
        or entry.st_uid != os.getuid()
        or stat.S_IMODE(entry.st_mode) != 0o600):
    sys.exit(f'{path}: expected a regular person VM host configuration owned by the current user with mode 0600 (no symlinks)')
print(f'--person-vm-config={path}')
PY
}

deploy() {
  local ref=origin/main force=0 smoke=1 snap=0 require_vm_config=0
  while [ $# -gt 0 ]; do case "$1" in
    --ref) ref=${2:?}; shift 2 ;; --force) force=1; shift ;; --skip-smoke) smoke=0; shift ;;
    --force-snapshot) snap=1; shift ;;
    --require-person-vm-config) require_vm_config=1; shift ;;
    *) die "unknown option $1" 2 ;; esac; done
  local vm_config_arg
  vm_config_arg=$(person_vm_config_arg "$require_vm_config") || die "person VM host configuration check failed. Dev untouched." 2
  if [ -n "$vm_config_arg" ]; then require_vm_config=1; fi
  local t0; t0=$(date +%s)
  ! lock_held "$LOCK" || die "a deploy is in progress ($("$BIN/deploy-lock" status)); stop and retry later" 3
  [ ! -e "$INFLIGHT" ] || die "an earlier deploy did not finish; run $DEPLOY_COMMAND --release-manager --recover first"
  recovery_pair "$(dev_plist web)" "$(dev_plist worker)" || die "refusing a mismatched Dev configuration" 2
  local avail; avail=$(df -g "$HOME" | awk 'NR==2{print $4}')
  [ "$avail" -ge 20 ] || die "only ${avail}G free; clean up before building"

  git -C "$REPO" fetch -q origin
  local sha; sha=$(resolve_ref "$ref")
  local cur_rel cur_sha cur_art; cur_rel=$(release_of); cur_sha=$(penv "$(dev_plist worker)" ALLRICE_RELEASE_SHA); cur_art=$(penv "$(dev_plist worker)" ALLRICE_DSH_NATIVE_ARTIFACT_ID)
  local cur_active=0
  if [ -f "$WEB_PLIST" ] && [ -f "$WORKER_PLIST" ]; then cur_active=1; fi
  if [ "$cur_active" = 1 ] && [ "$sha" = "$cur_sha" ] && [ $force = 0 ]; then say "Dev already runs ${sha:0:8}; nothing to deploy (use --force to rebuild)"; return 0; fi

  local rel; rel="$RELEASES/$(date +%Y%m%d-%H%M)-${sha:0:8}"
  [ -e "$rel" ] && die "release directory exists: $rel"
  mkdir -p "$STATE/deploy-logs"; BLOG="$STATE/deploy-logs/$(basename "$rel").log"
  say "building ${sha:0:8} ($ref) in $(basename "$rel"); log: $BLOG"
  git -C "$REPO" worktree add -q --detach "$rel" "$sha"
  BUILD_DIR=$rel
  ( cd "$rel" && pnpm install --frozen-lockfile && \
    pnpm -r --workspace-concurrency=1 --filter '@allrice/worker...' --filter '@allrice/web...' --if-present run build ) > "$BLOG" 2>&1 \
    || { log_deploy kind failed phase build sha "$sha" log "$BLOG"; die "build failed; see $BLOG (Dev untouched)"; }
  local art
  art=$(cd "$rel" && node apps/worker/scripts/prepare-native-artifact.mjs --root="$PWD" 2>>"$BLOG" | tail -1 | "$M1_PY" -c 'import json,sys;print(json.load(sys.stdin)["artifactId"])') \
    || { log_deploy kind failed phase artifact sha "$sha" log "$BLOG"; die "native artifact preparation failed; see $BLOG (Dev untouched)"; }
  # The operator may supply the file while the build runs. Refuse if a
  # previously selected file disappears instead of sealing without it.
  vm_config_arg=$(person_vm_config_arg "$require_vm_config") \
    || { log_deploy kind failed phase identity sha "$sha" log "$BLOG"; die "person VM host configuration check failed. Dev untouched." 2; }
  ( cd "$rel" || exit 1
    set -- --root="$rel" --release-sha="$sha"
    if [ -n "$vm_config_arg" ]; then set -- "$@" "$vm_config_arg"; fi
    node scripts/dev-release/prepare-identity.mjs "$@"
  ) >> "$BLOG" 2>&1 \
    || { log_deploy kind failed phase identity sha "$sha" log "$BLOG"; die "build identity failed; see $BLOG (Dev untouched). Versions before PR #533 cannot seal identity on M1."; }
  dev_release_config "$rel" "$sha" || die "refusing an invalid 4.0 release" 2
  say "built in $(( $(date +%s) - t0 ))s; native artifact ${art:7:12}… ($([ "$art" = "$cur_art" ] && echo unchanged || echo CHANGED))"

  say "pre-stop check: does ${sha:0:8} cover the current chats and schedule controls?"
  local why; if ! why=$(precheck "$rel" "$sha" "$art" "$BLOG"); then
    log_deploy kind failed phase precheck sha "$sha" reason "$why" log "$BLOG"; die "$why. Dev untouched." 4
  fi
  BUILT=1 # from here the build is kept, also when the lock is busy

  take_lock || die "another deploy started meanwhile; build kept at $rel (rerun deploy-dev later)" 3
  [ ! -e "$INFLIGHT" ] || die "an earlier deploy did not finish; build kept at $rel. Run $DEPLOY_COMMAND --release-manager --recover first"
  [ "$(release_of)" = "$cur_rel" ] || die "Dev changed while this version was building; build kept at $rel, start again"
  recovery_pair "$(dev_plist web)" "$(dev_plist worker)" "$cur_sha" || die "refusing a mismatched Dev configuration" 2
  stage_plists "$rel" "$sha" "$art" || die "release configuration failed validation. Dev untouched" 2
  local pending; pending=$(check_migrations_known "$rel") || {
    log_deploy kind failed phase migrations sha "$sha" reason "$pending" log "$BLOG"
    die "not starting ${sha:0:8}: $pending; build kept at $rel (Dev untouched)."; }
  why=$(check_contract_known "$rel") || {
    log_deploy kind failed phase contract sha "$sha" reason "$why" log "$BLOG"; die "$why; build kept at $rel (Dev untouched)."; }
  local down_at boot; down_at=$(date +%s); boot=$(worker_boot)
  inflight_begin "$cur_sha"
  say "stopping web and worker"
  stop_both || die "services did not stop"
  report_after_stop "$boot"
  pre_migrate_snapshot "$(basename "$rel")" "$pending" "$snap"
  inflight_phase migrating
  say "db:prepare (migrate, sync platform content, verify)"
  ( cd "$rel" && "$BIN/with-env" worker pnpm db:prepare ) >> "$BLOG" 2>&1 || die "db:prepare failed; see $BLOG"
  inflight_phase switching
  activate_plists
  start_both_on "$sha" || die "${sha:0:8} did not become healthy"
  local downtime=$(( $(date +%s) - down_at ))
  # Records first, then clear the in-flight state, then release the lock.
  log_deploy kind deploy fromRelease "$cur_rel" fromSha "$cur_sha" fromArtifact "$cur_art" toRelease "$rel" toSha "$sha" toArtifact "$art" ref "$ref" downtimeSeconds "$downtime"
  # Parked configuration may never have been healthy: do not offer it as the default rollback.
  if [ "$cur_active" = 1 ]; then printf '%s\n%s\n' "$cur_rel" "$rel" > "$STATE/.previous-release"
  else rm -f "$STATE/.previous-release"; fi
  inflight_end; release_lock
  say "Dev now runs ${sha:0:8} (downtime ${downtime}s); lock released"
  prune_releases

  if [ $smoke = 1 ]; then
    local out; out="$STATE/smoke/$(date +%Y%m%d-%H%M%S)-${sha:0:8}"
    say "running the smoke test against ${sha:0:8}"
    local ok=0; "$BIN/smoke-test" --dev --expect-sha "$sha" --out "$out" && ok=1
    log_deploy kind smoke sha "$sha" result "$([ $ok = 1 ] && echo passed || echo failed)" out "$out"
    if [ $ok != 1 ]; then
      local hint
      if previous_release >/dev/null; then hint="to switch back run: $DEPLOY_COMMAND --release-manager --rollback"
      else hint="no default rollback target is recorded; fix forward or choose a compatible target: $DEPLOY_COMMAND --release-manager --rollback <release-dir>"; fi
      die "smoke test failed on ${sha:0:8}. Inspect $out/result.json; $hint" 5
    fi
    say "smoke passed"
  fi
  say "done in $(( $(date +%s) - t0 ))s"
}

[ "${BASH_SOURCE[0]}" = "$0" ] || return 0 # sourced for its functions (test_deploy_dev.py)

# --release-manager is a deliberate speed bump: a session the user did not appoint as
# release manager stops here and writes its deploy request on its MET card instead.
RM=0; ARGS=()
for a in "$@"; do
  case "$a" in
    --release-manager) RM=1 ;;
    --person-vm-drain-socket=*) DRAIN_SOCKET=${a#*=} ;;
    *) ARGS+=("$a") ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}
need_rm() {
  [ "$RM" = 1 ] || die "only the release manager deploys or rolls back the shared Dev (AGENTS.md §9 at the repository root). If the user appointed you, add --release-manager; otherwise write the deploy request on your MET card and stop." 6
}
MODE="${1:-deploy}"

# A unique receipt is prepared before authorization/arguments are checked, so even
# a refused invocation has a truthful terminal result. Status/help remain read-only.
if [ "$MODE" != --status ] && [ "$MODE" != -h ] && [ "$MODE" != --help ]; then
  RESULT_ID="${ALLRICE_DEPLOY_RESULT_ID:-$("$M1_PY" -c 'import uuid; print(uuid.uuid4())')}"
  candidate="${ALLRICE_DEPLOY_RESULT_FILE:-$STATE/deploy-results/$RESULT_ID.json}"
  "$M1_PY" "$BIN/deploy-result.py" start "$candidate" "$RESULT_ID"
  RESULT_FILE="$candidate"
fi

case "${1:-}" in
  --status) status ;;
  --rollback) need_rm; shift; rollback "${1:-}" ;;
  --recover) need_rm; recover ;;
  -h|--help) sed -n 2,34p "$0" ;;
  *) need_rm; deploy "$@" ;;
esac
