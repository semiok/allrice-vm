{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node", "react"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "build.mjs",
    "index.mjs",
    "host/**/*.mjs",
    "src/**/*.cjs",
    "src/**/*.mjs",
    "src/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "tests/fixtures/employee-panels/employee-panel-data-page.tsx",
    "tests/fixtures/employee-panels/employee-panel-live-page.tsx"
  ]
}
